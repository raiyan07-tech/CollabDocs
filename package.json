{
  "name": "collabdocs-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CollabDocs - Real-time collaborative document editor monorepo",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=server",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prisma:studio": "npm run prisma:studio --workspace=server"
  },
  "keywords": [
    "collaboration",
    "yjs",
    "tiptap",
    "webrtc",
    "websocket",
    "react",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "CollabDocs Team",
  "license": "MIT"
}
